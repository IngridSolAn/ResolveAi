# Copie para .env e preencha. O .env NUNCA deve ir para o git.

# --- Qual IA gera o diagnóstico ---
# ollama  = gratuita, roda localmente (padrão)
# claude  = paga, API da Anthropic (melhor qualidade, resposta mais rápida)
# offline = sem IA, só lista os chamados parecidos
RESOLVEAI_LLM=ollama

# --- Ollama (gratuito) ---
# Fora do Docker: http://localhost:11434 (no Docker o compose já aponta para o serviço).
OLLAMA_HOST=http://localhost:11434
# Modelos menores respondem mais rápido em PCs sem GPU (ex.: qwen2.5:3b).
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=300

# --- Claude (pago, opcional) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (mais alto = mais análise e mais custo)
CLAUDE_EFFORT=medium

# --- Segurança entre o plugin GLPI e o backend ---
# Se definido, o backend exige "Authorization: Bearer <token>".
RESOLVEAI_API_TOKEN=
# Token interno do PAINEL DA IA (GLPI > Ferramentas > Painel da IA, só Super-Admin).
# Ninguém digita este token: o GLPI o usa, servidor a servidor, para ler a
# telemetria do backend. Use um valor diferente do RESOLVEAI_API_TOKEN.
# Sem ele, o painel fica desativado. Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
RESOLVEAI_ADMIN_TOKEN=
# Tempo máximo (segundos) que o plugin espera pela análise.
RESOLVEAI_API_TIMEOUT=300

# --- Indexação do histórico (python -m app.index) ---
# Use uma conta somente leitura, de preferência numa réplica.
GLPI_READONLY_DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/glpi

# --- API REST do GLPI (reservado para o conector via API) ---
GLPI_BASE_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
